#!/usr/bin/env bash
# The hook is installed/refreshed by AgentChirp at launch; ordinary `codex` is unchanged.
set -e
adapter="${CODEX_HOME:-$HOME/.codex}/hooks/agentchirp.sh"
if [ ! -x "$adapter" ]; then
  printf '%s\n' 'Start AgentChirp once to install its Codex integration, then retry codex-chirp.' >&2
  exit 1
fi
exec "$adapter" launch-codex "$@"
